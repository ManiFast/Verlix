<Window x:Class="Mobks.SecurityCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Velrix" Icon="Velrix.ico" Width="1000" Height="710" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#242424" Foreground="#F2F2F2"
        FontFamily="Tahoma" FontSize="13" UseLayoutRounding="True"
        SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#242424"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2E2E2E"/>
        <SolidColorBrush x:Key="LineBrush" Color="#3B3B3B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#B4B4B4"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#58D3E0"/>

        <Style x:Key="CheckRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="#383838"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="MinHeight" Value="62"/>
        </Style>
        <Style x:Key="CheckIcon" TargetType="Path">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CheckText" TargetType="StackPanel">
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="CheckTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CheckHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#A3A3A3"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CheckStatus" TargetType="TextBlock">
            <Setter Property="Text" Value="Не проверено"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="18,0,0,0"/>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#3B3B3B"/>
            <Setter Property="BorderBrush" Value="#505050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="MinWidth" Value="178"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#484848"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#303030"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2C2C2C"/>
                    <Setter Property="Foreground" Value="#929292"/>
                    <Setter Property="BorderBrush" Value="#3C3C3C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#10272A"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7DDEEA"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#43B8C5"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#344A4D"/>
                    <Setter Property="BorderBrush" Value="#435C60"/>
                    <Setter Property="Foreground" Value="#A9BEC0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SaveIconButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Unsaved">
                    <Setter Property="Background" Value="#293D40"/>
                    <Setter Property="BorderBrush" Value="#58D3E0"/>
                    <Setter Property="Foreground" Value="#8EE0EA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Margin="2.5,0" MinHeight="24">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBorder" Background="#666666" CornerRadius="3"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBorder" Property="Background" Value="#888888"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DetailsExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" Foreground="{StaticResource MutedBrush}"
                                          HorizontalContentAlignment="Left">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <Path x:Name="Arrow" Data="M2,3 L6,7 L10,3" Stroke="{TemplateBinding Foreground}"
                                                      StrokeThickness="1.3" Width="12" Height="10" Margin="0,0,8,0"
                                                      VerticalAlignment="Center"/>
                                                <ContentPresenter RecognizesAccessKey="True"/>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Data" Value="M2,7 L6,3 L10,7"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="DetailsBody" ContentSource="Content" Visibility="Collapsed"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="DetailsBody" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JournalTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="#CDCDCD"/>
            <Setter Property="FontFamily" Value="Tahoma"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SelectionBrush" Value="#356D75"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Setter Property="CaretBrush" Value="#D0D0D0"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="JournalTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabHeader" Background="Transparent" Padding="14,9"
                                BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabHeader" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabHeader" Property="Background" Value="#303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition x:Name="JournalRow" Height="0" MinHeight="0" MaxHeight="440"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" CanContentScroll="False">
            <StackPanel Margin="28,24,28,20">
                <DockPanel LastChildFill="True">
                    <Button x:Name="VersionButton" DockPanel.Dock="Right" Content="v1.0.0" Cursor="Hand"
                            FontSize="11" Foreground="#949494" VerticalAlignment="Center" Padding="8,6"
                            ToolTip="Исходный код и выпуски на GitHub" AutomationProperties.Name="Версия и страница проекта">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <TextBlock Text="Проверка защиты" FontSize="22" VerticalAlignment="Center"/>
                </DockPanel>

                <Grid Margin="0,14,0,22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="OverallIndicator" Width="10" Height="10" Fill="#919191"
                             HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SummaryText" Grid.Column="1" Text="Проверки не запускались" FontSize="13"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="LastRunText" Grid.Column="2" Text="" FontSize="12"
                               Foreground="{StaticResource MutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <TextBlock Text="Проверки" FontSize="14" Margin="0,0,0,10"/>

                <Border Style="{StaticResource CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource CheckIcon}" Data="M12,2 A10,10 0 1 0 12,22 A10,10 0 1 0 12,2 M2,12 H22 M12,2 C7,7 7,17 12,22 M12,2 C17,7 17,17 12,22"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource CheckText}">
                            <TextBlock Text="Интернет" Style="{StaticResource CheckTitle}"/>
                            <TextBlock x:Name="InternetHintText" Text="Россия, СНГ, США, Азия" Style="{StaticResource CheckHint}"
                                       ToolTip="HTTPS-запросы к четырём выбранным серверам. Показано время запроса, а не ICMP ping."/>
                        </StackPanel>
                        <TextBlock x:Name="InternetStatus" Grid.Column="2" Style="{StaticResource CheckStatus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource CheckIcon}" Data="M12,2 L21,6 V11 C21,16 17,20 12,22 C7,20 3,16 3,11 V6 Z"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource CheckText}">
                            <TextBlock Text="Антивирус" Style="{StaticResource CheckTitle}"
                                       ToolTip="Название и состояние, сообщаемые центром безопасности Windows."/>
                            <TextBlock x:Name="AntivirusHintText" Text="Состояние защиты" Style="{StaticResource CheckHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="AntivirusStatus" Grid.Column="2" Style="{StaticResource CheckStatus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource CheckIcon}" Data="M5,2 H15 L21,8 V22 H5 Z M15,2 V8 H21 M9,13 H17 M9,17 H15"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource CheckText}">
                            <TextBlock Text="Тест антивируса" Style="{StaticResource CheckTitle}"/>
                            <TextBlock x:Name="AntivirusTestHintText" Text="Выберите файл EICAR" Style="{StaticResource CheckHint}"
                                       ToolTip="Проверка реакции на копию выбранного файла. Исходный файл не запускается."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="SelectEicarFileButton" Content="Файл…" Style="{StaticResource ActionButton}"
                                    MinWidth="72" Width="72" MinHeight="30" Height="30" Padding="8,0" FontSize="12"
                                    Margin="0,0,12,0" ToolTip="Выбрать подготовленный файл EICAR"/>
                            <TextBlock x:Name="AntivirusTestStatus" Width="160" Margin="0" Style="{StaticResource CheckStatus}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CheckRow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource CheckIcon}" Data="M3,4 H21 V21 H3 Z M3,10 H21 M3,15 H21 M9,4 V10 M15,10 V15 M9,15 V21"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource CheckText}">
                            <TextBlock Text="Брандмауэр Windows" Style="{StaticResource CheckTitle}"
                                       ToolTip="В окне показан активный профиль. Настройки всех трёх профилей сохраняются в отчёте."/>
                            <TextBlock x:Name="FirewallHintText" Text="Состояние сетевых профилей" Style="{StaticResource CheckHint}"/>
                        </StackPanel>
                        <TextBlock x:Name="FirewallStatus" Grid.Column="2" Style="{StaticResource CheckStatus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CheckRow}" Margin="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="180"/>
                        </Grid.ColumnDefinitions>
                        <Path Style="{StaticResource CheckIcon}" Data="M12,2 L21,6 V11 C21,16 17,20 12,22 C7,20 3,16 3,11 V6 Z M8,9 H16 M13,6 L16,9 L13,12 M16,15 H8 M11,12 L8,15 L11,18"/>
                        <StackPanel Grid.Column="1" Style="{StaticResource CheckText}">
                            <TextBlock Text="Тест брандмауэра" Style="{StaticResource CheckTitle}"/>
                            <TextBlock x:Name="FirewallTestHintText" Text="Временный запрет исходящего TCP-соединения" Style="{StaticResource CheckHint}"
                                       ToolTip="Соединение до запрета, блокировка своим правилом, удаление правила и повторное соединение."/>
                        </StackPanel>
                        <TextBlock x:Name="FirewallTestStatus" Grid.Column="2" Style="{StaticResource CheckStatus}"/>
                    </Grid>
                </Border>


            </StackPanel>
        </ScrollViewer>

        <Expander x:Name="JournalExpander" Grid.Row="1" Header="Журнал проверки"
                  Style="{StaticResource DetailsExpander}" Margin="28,8,28,4"/>
        <GridSplitter x:Name="JournalSplitter" Grid.Row="1" Height="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="28,0,28,0"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Cursor="SizeNS"
                      ToolTip="Потяните, чтобы изменить высоту журнала"
                      Background="Transparent" Visibility="Collapsed">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Divider" Height="1" VerticalAlignment="Center" Background="#414141"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Divider" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>
        <Border x:Name="JournalPane" Grid.Row="2" Margin="28,0,28,14" Visibility="Collapsed"
                Background="#202020" BorderBrush="#3B3B3B" BorderThickness="1" CornerRadius="4">
            <TabControl Background="Transparent" BorderThickness="0" SelectedIndex="0"
                        ItemContainerStyle="{StaticResource JournalTab}">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border BorderBrush="#3B3B3B" BorderThickness="0,0,0,1">
                                <TabPanel IsItemsHost="True" Background="Transparent"/>
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>
                <TabItem Header="События">
                    <TextBox x:Name="DetailsTextBox" Style="{StaticResource JournalTextBox}"
                             Text="Проверки ещё не запускались."/>
                </TabItem>
                <TabItem Header="Технический вывод">
                    <TextBox x:Name="TechnicalOutputTextBox" Style="{StaticResource JournalTextBox}"
                             FontFamily="Consolas" FontSize="12"
                             Text="Здесь появятся вызовы API и полученные ответы."/>
                </TabItem>
            </TabControl>
        </Border>

        <Border Grid.Row="3" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterHintText" Text="Результатов пока нет" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="RunChecksButton" Style="{StaticResource PrimaryButton}">
                        <TextBlock x:Name="RunButtonText" Text="Запустить проверки"/>
                    </Button>
                    <Button x:Name="SaveReportButton" Style="{StaticResource SaveIconButton}" IsEnabled="False"
                            Margin="10,0,0,0" ToolTip="Сохранить отчёт" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Сохранить отчёт">
                        <Path Data="M2,1 H12 L15,4 V15 H2 Z M5,1 V6 H11 V1 M5,15 V10 H12 V15"
                              Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.2"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
